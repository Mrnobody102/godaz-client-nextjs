NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_LOCAL_AUTH_FALLBACK=false

# Production checklist:
# - NEXT_PUBLIC_API_URL must point to the deployed backend origin.
# - Backend CORS must allow the deployed Vercel/custom-domain origin.
# - NEXT_PUBLIC_GOOGLE_CLIENT_ID is required only when Google login is enabled.
# - Keep NEXT_PUBLIC_ENABLE_LOCAL_AUTH_FALLBACK=false outside local demo testing.
